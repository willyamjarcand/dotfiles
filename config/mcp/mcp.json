{
  "settings": {
    "allowInstall": false
  },
  "mcpServers": {
    "excalidraw": {
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "auth": "bearer",
      "bearerToken": "!security find-generic-password -a \"$USER\" -s excalidraw_plus_api_key -w",
      "approveTools": [
        "delete_*",
        "remove_*",
        "update_workspace*",
        "create_email_invite",
        "create_invite_link",
        "update_invite"
      ]
    }
  }
}

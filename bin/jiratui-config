#!/usr/bin/env bash
# Render ~/.config/jiratui/config.yaml from the environment.
#
# jiratui requires the API token as a literal value in its config file (no env
# interpolation), so the config is generated rather than committed — secrets
# never live in the repo. JIRA_API_TOKEN comes from the shell environment:
#   work laptop:     ~/.config/wealthsimple/env.secrets (sourced by zshrc)
#   personal laptop: ~/.zshrc.local
set -euo pipefail

xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="$xdg/jiratui"
config_file="$config_dir/config.yaml"

# Machine-aware defaults: a work laptop is identified by ~/.config/wealthsimple.
if [[ -d "$xdg/wealthsimple" ]]; then
  default_base_url="https://wealthsimple.atlassian.net"
  default_username="willyam.arcand@wealthsimple.com"
  default_project_default="DBE"
else
  default_base_url=""
  default_username="$(git config user.email 2>/dev/null || true)"
  default_project_default=""
fi

base_url="${JIRA_API_BASE_URL:-$default_base_url}"
username="${JIRA_API_USERNAME:-$default_username}"
token="${JIRA_API_TOKEN:-}"
# Project pre-selected on launch (jiratui fetches only this project → faster start).
# Defaults to DBE on the work laptop; override with JIRA_DEFAULT_PROJECT.
default_project="${JIRA_DEFAULT_PROJECT:-$default_project_default}"

if [[ -z "$token" ]]; then
  echo "jiratui-config: JIRA_API_TOKEN is not set." >&2
  echo "  work laptop:     add 'export JIRA_API_TOKEN=...' to ~/.config/wealthsimple/env.secrets" >&2
  echo "  personal laptop: add JIRA_API_TOKEN (and JIRA_API_BASE_URL / JIRA_API_USERNAME) to ~/.zshrc.local" >&2
  exit 1
fi

mkdir -p "$config_dir"
umask 077
cat >"$config_file" <<EOF
# Generated by ~/.bin/jiratui-config — do not edit by hand (regenerate with: jiratui-config).
jira_api_base_url: "$base_url"
jira_api_username: "$username"
jira_api_token: "$token"

# Pre-made filters shown in the UI dropdown, tuned to the day-to-day flow.
# Status/recency based since sprints are rarely current; currentUser() = me.
pre_defined_jql_expressions:
  1: { label: "My open work (DBE)",       expression: "project = DBE AND assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC" }
  2: { label: "My in-progress (DBE)",     expression: "project = DBE AND assignee = currentUser() AND statusCategory = 'In Progress' ORDER BY updated DESC" }
  3: { label: "DBE updated last 3 days",  expression: "project = DBE AND updated >= -3d ORDER BY updated DESC" }
  4: { label: "Reported by me (open)",    expression: "reporter = currentUser() AND statusCategory != Done ORDER BY created DESC" }
  5: { label: "On-call: Chequing & Savings (EOC)", expression: "project = EOC AND 'Mandate' = 'Chequing and Savings' AND statusCategory != Done ORDER BY created DESC" }
  6: { label: "My current sprint (DBE)",  expression: "project = DBE AND assignee = currentUser() AND sprint in openSprints() ORDER BY rank" }
# Filter run automatically on launch:
jql_expression_id_for_work_items_search: 1
EOF
[[ -n "$default_project" ]] && echo "default_project_key_or_id: \"$default_project\"" >>"$config_file"
chmod 600 "$config_file"
echo "Wrote $config_file"
